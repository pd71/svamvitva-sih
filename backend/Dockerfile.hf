FROM python:3.11-slim

WORKDIR /app

# Install system dependencies for OpenCV and spatial graphics
RUN apt-get update && apt-get install -y --no-install-recommends \
    libgl1-mesa-glx \
    libglib2.0-0 \
    libgdal-dev \
    gcc \
    g++ \
    && rm -rf /var/lib/apt/lists/*

# Create user 1000 for Hugging Face Spaces non-root execution
RUN useradd -m -u 1000 user
ENV HOME=/home/user \
    PATH=/home/user/.local/bin:$PATH

COPY requirements.txt .
RUN pip install --no-cache-dir -r requirements.txt

COPY --chown=user:user . /app

# Create writable directories for database and uploads
RUN mkdir -p /app/uploaded_images /app/svamitva_dataset_repository && \
    chown -R user:user /app

USER user

EXPOSE 7860

CMD ["uvicorn", "app.main:app", "--host", "0.0.0.0", "--port", "7860"]
